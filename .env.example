# ---- Cloudinary ----
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=aravindh-portfolio

# ---- Turso database (fixes "server storage is read-only") ----
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=

# ---- Resend email ----
RESEND_API_KEY=
# Inbox that receives enquiries (comma-separate for several)
ENQUIRY_TO_EMAIL=you@yourmail.com
# Use a verified-domain address in production, e.g. MAVX Frames <hello@mavxframes.com>
RESEND_FROM=MAVX Frames <onboarding@resend.dev>

# ---- Site / admin ----
# Used for canonical URLs, sitemap and robots (read by lib/seo.ts)
NEXT_PUBLIC_SITE_URL=https://www.mavxframes.com
ADMIN_KEY=
