# Set your actual primary production URL, matching your Vercel domain redirect.
NEXT_PUBLIC_SITE_URL=https://mavx-frames.vercel.app
# Optional public business details. Blank values are hidden.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_YOUTUBE_URL=
# Optional Search Console / Bing verification tokens (token only).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# Keep existing real credentials in .env.local / Vercel, never commit them.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=mavx-frames
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=
RESEND_FROM=
ENQUIRY_WEBHOOK_URL=
ADMIN_KEY=
